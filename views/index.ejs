<%- include('partials/head') %> <%- include('partials/nav') %>

<header class="hero">
  <div class="container">
    <h1>Borrow from your neighbors</h1>
    <p>
      Why buy a drill you'll use twice a year? Find what you need nearby, and
      lend what's sitting in your garage.
    </p>
    <a href="/signup" class="btn btn-primary">
      <i class="fa-solid fa-user-plus"></i> Get started
    </a>
  </div>
</header>

<main class="container section">
  <h2>How it works</h2>
  <div class="grid">
    <div class="card">
      <div class="card-icon"><i class="fa-solid fa-box-open"></i></div>
      <h3>List what you have</h3>
      <p class="muted">
        Add tools, ladders, folding tables, anything you're happy to lend.
      </p>
    </div>
    <div class="card">
      <div class="card-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
      <h3>Find what you need</h3>
      <p class="muted">
        Browse by category or zip code and send a borrow request with dates.
      </p>
    </div>
    <div class="card">
      <div class="card-icon"><i class="fa-solid fa-handshake"></i></div>
      <h3>Borrow and return</h3>
      <p class="muted">
        The owner approves, you pick it up, and it's marked returned when you're
        done.
      </p>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
