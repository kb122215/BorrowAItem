<nav class="nav">
  <div class="container">
    <a href="/" class="logo">
      <i class="fa-solid fa-hand-holding-heart"></i> BorrowAItem
    </a>

    <div class="nav-links">
      <% if (locals.currentUser) { %>
        <a href="/items"><i class="fa-solid fa-magnifying-glass"></i> Browse</a>
        <a href="/items/mine"><i class="fa-solid fa-box-open"></i> My Items</a>
        <a href="/borrows/mine"><i class="fa-solid fa-handshake"></i> My Borrows</a>
        <a href="/borrows/requests">
          <i class="fa-solid fa-inbox"></i> Requests
          <% if (locals.pendingCount) { %>
            <span class="nav-count"><%= pendingCount %></span>
          <% } %>
        </a>
        <form action="/logout" method="POST">
          <button type="submit" class="btn-link">
            <i class="fa-solid fa-right-from-bracket"></i> Log out
          </button>
        </form>
      <% } else { %>
        <a href="/login">Log in</a>
        <a href="/signup" class="btn btn-primary">Sign up</a>
      <% } %>
    </div>
  </div>
</nav>
<%- include('flash') %>